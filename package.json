{
  "name": "dsh-error-atlas",
  "version": "0.11.26",
  "type": "module",
  "description": "Records runtime errors and coding-task retrospectives, collapses noisy shell failures into command fingerprints, distils each lesson into one injected rule, and renders the whole thing as an interactive GPU knowledge graph (WebGL) with lesson links, recurrence flags, program satellites, session islands, orbit-any-node camera, search and activity trends.",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "chaos-miku",
  "homepage": "https://github.com/chaos-miku/dsh-error-atlas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaos-miku/dsh-error-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/chaos-miku/dsh-error-atlas/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "retrospective",
    "knowledge-graph",
    "error-tracking",
    "agent-memory",
    "webgl"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "bin/*.mjs",
    "test/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.jpg",
    "docs/*.png",
    "CHANGELOG.md",
    "screenshots.json"
  ],
  "bin": {
    "atlas-retro": "bin/atlas-retro.mjs",
    "atlas-digest": "bin/atlas-digest.mjs"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "smoke": "node test/smoke.mjs",
    "digest": "node bin/atlas-digest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
